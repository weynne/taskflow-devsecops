# Copie para .env (que esta no .gitignore) e preencha com valores PROPRIOS.
# Apenas este arquivo de EXEMPLO e versionado; o .env real nunca vai pro Git.
# Gere valores aleatorios, por exemplo:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"

# --- TaskFlow (web) ----------------------------------------------------------
TASKFLOW_SECRET_KEY=
ADMIN_PASSWORD=
# Opcional: cria o usuario "aluno" (usado pelo DAST e pela simulacao de forca bruta)
ALUNO_PASSWORD=

# --- Banco (db) - PostgreSQL "simulado" do laboratorio -----------------------
POSTGRES_USER=taskflow_admin
POSTGRES_PASSWORD=
POSTGRES_DB=taskflow

# --- Observabilidade (docker-compose.observability.yml) ----------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
